  <!-- Footer Situs -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <h3>NamaBerita</h3>
          <p>Portal media informasi independen yang menyajikan peristiwa terkini, investigasi terpercaya, dan kabar penting dari seluruh penjuru nusantara dan dunia.</p>
        </div>

        <div class="footer-links">
          <h4>Kategori Pilihan</h4>
          <ul class="footer-nav">
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
              <% categories.forEach(cat => { %>
                <li><a href="/kategori/<%= cat.slug %>"><%= cat.name %></a></li>
              <% }) %>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <strong>NamaBerita</strong>. Hak Cipta Dilindungi Undang-Undang.</p>
      </div>
    </div>
  </footer>
</body>
</html>
